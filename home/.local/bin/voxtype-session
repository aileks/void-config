#!/usr/bin/env bash

set -Eeuo pipefail

umask 077
exec 9>"${XDG_RUNTIME_DIR:?}/voxtype-session.lock"
flock -n 9 || exit 0

log_directory=${XDG_STATE_HOME:-$HOME/.local/state}/voxtype
mkdir -p -- "$log_directory"
exec >"$log_directory/session.log" 2>&1
trap 'printf "Voxtype session failed at line %s.\n" "$LINENO" >&2; notify-send -u critical "Voxtype stopped" "See $log_directory/session.log" || true' ERR

export VK_DRIVER_FILES=/usr/share/vulkan/icd.d/nvidia_icd.json
[[ -r $VK_DRIVER_FILES ]]

for ((attempt = 0; attempt < 10; attempt++)); do
  if timeout 1 pactl info >/dev/null 2>&1; then
    voxtype --quiet daemon &
    daemon_pid=$!
    voxtype-osd-x11 &
    overlay_pid=$!
    trap 'kill "$daemon_pid" "$overlay_pid" 2>/dev/null || true; wait "$daemon_pid" "$overlay_pid" 2>/dev/null || true' EXIT
    trap 'exit 130' HUP INT TERM
    wait -n "$daemon_pid" "$overlay_pid"
    printf 'Voxtype or its overlay exited unexpectedly.\n' >&2
    false
  fi
  sleep 1
done

printf 'PipeWire did not become ready.\n' >&2
notify-send -u critical 'Voxtype could not start' 'PipeWire did not become ready.' || true
exit 1
