#!/usr/bin/env bash

set -Eeuo pipefail

action=${1:?usage: brightness <up|down>}
case $action in
  up) delta=(+ 10) ;;
  down) delta=(- 10) ;;
  *)
    printf 'usage: brightness <up|down>\n' >&2
    exit 2
    ;;
esac

ddcutil setvcp 0x10 "${delta[@]}" >/dev/null 2>&1 || true
percent=$(ddcutil getvcp 0x10 -t \
  | awk '/^VCP 10 C [0-9]+ [0-9]+$/ && $5>0 && $4<=$5 { printf "%d", $4*100/$5 }')
if [[ -n ${percent:-} ]]; then
  dunstify -a brightness -h int:value:"$percent" -h string:x-dunst-stack-tag:brightness Brightness "$percent%" || true
fi
