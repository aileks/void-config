#!/usr/bin/env bash

set -Eeuo pipefail

export BEMOJI_PICKER_CMD='rofi -dmenu -i -lines 8 -p Emoji'
export BEMOJI_CLIP_CMD='xclip -selection clipboard'
export BEMOJI_TYPE_CMD='xdotool sleep 0.1 type --clearmodifiers --delay 0 --'
export BEMOJI_ECHO_NEWLINE=false
# bemoji evaluates this command after the picker exits.
# shellcheck disable=SC2016
export BEMOJI_DEFAULT_CMD='emoji=$(cat); printf %s "$emoji" | xclip -selection clipboard && xdotool sleep 0.1 type --clearmodifiers --delay 0 -- "$emoji"'

exec "$HOME/.local/libexec/bemoji" "$@"
