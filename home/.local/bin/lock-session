#!/usr/bin/env bash

set -Eeuo pipefail

runtime_directory=${XDG_RUNTIME_DIR:?}
[[ -d $runtime_directory && -O $runtime_directory ]] || exit 1
umask 077
exec 9>"$runtime_directory/lock-session.lock"
flock -w 5 9 || exit 1

if pgrep -u "$UID" -x xsecurelock >/dev/null; then
  exit 0
fi

export XSECURELOCK_BACKGROUND_COLOR='#090909'
export XSECURELOCK_AUTH_BACKGROUND_COLOR='#090909'
export XSECURELOCK_AUTH_FOREGROUND_COLOR='#f3f3f3'
export XSECURELOCK_AUTH_WARNING_COLOR='#aaa198'
export XSECURELOCK_FONT='Iosevka Nerd Font:size=12'
export XSECURELOCK_SAVER=saver_blank

exec xsecurelock 9>&-
