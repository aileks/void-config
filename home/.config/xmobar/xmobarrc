Config
  { font = "Iosevka Nerd Font Propo Medium 11"
  , bgColor = "#1b1917"
  , fgColor = "#f1e6dc"
  , alpha = 255
  , position = TopH 28
  , border = NoBorder
  , lowerOnStart = True
  , allDesktops = True
  , overrideRedirect = False
  , hideOnStart = False
  , persistent = True
  , commands =
      [ Run UnsafeXMonadLog
      , Run Com "bar-dnd" [] "dnd" 10
      , Run Com "bar-volume" [] "volume" 10
      , Run Com "bar-cpu-temperature" [] "cpu" 50
      , Run Com "bar-memory" [] "memory" 50
      , Run Com "bar-gpu" [] "gpu" 50
      , Run Com "bar-network" [] "network" 50
      , Run Com "bar-clock" [] "clock" 10
      ]
  , sepChar = "%"
  , alignSep = "}{"
  , template = " %UnsafeXMonadLog% }{<fc=#b6ada5>%dnd%</fc> <fc=#504b47>│</fc> <fc=#b6ada5>%volume%</fc> <fc=#504b47>│</fc> <fc=#b6ada5>%cpu%</fc> <fc=#504b47>│</fc> <fc=#b6ada5>%memory%</fc> <fc=#504b47>│</fc> <fc=#b6ada5>%gpu%</fc> <fc=#504b47>│</fc> <fc=#b6ada5>%network%</fc> <fc=#504b47>│</fc> <fc=#b6ada5>%clock%</fc><hspace=92/>"
  }
