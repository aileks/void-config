* {
    background: #090909;
    foreground: #f1e6dc;
    border-color: #898078;
    selected-background: #898078;
    selected-foreground: #090909;
    background-color: @background;
    text-color: @foreground;
    border-radius: 0px;
}

window {
    location: center;
    anchor: center;
    width: 600px;
    border: 2px;
    padding: 12px;
}

mainbox {
    children: [ inputbar, listview, mode-switcher ];
    spacing: 8px;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 10px;
    padding: 8px;
}

entry {
    placeholder: "Search";
}

listview {
    lines: 8;
    columns: 1;
    spacing: 4px;
    fixed-height: false;
    scrollbar: false;
}

element {
    children: [ element-icon, element-text ];
    spacing: 8px;
    padding: 8px;
}

element-icon {
    size: 24px;
}

element-text {
    vertical-align: 0.5;
    background-color: inherit;
    text-color: inherit;
}

element selected.normal, element selected.active, button selected {
    background-color: @selected-background;
    text-color: @selected-foreground;
}

mode-switcher {
    spacing: 4px;
}

button {
    padding: 6px;
}
