[global]
dmenu = rofi -dmenu -i -lines 3 -p Notifications
follow = none
width = 380
height = (0, 120)
origin = top-right
offset = (5, 5)
frame_width = 2
frame_color = "#646361"
separator_color = frame
font = Iosevka Nerd Font 12
icon_position = left
icon_theme = Papirus-Dark
max_icon_size = 32
gap_size = 6
padding = 10
horizontal_padding = 12
text_icon_padding = 10
corner_radius = 0
format = "<b>%s</b>\n%b"
background = "#171614"
foreground = "#f0eeeb"
highlight = "#c2c1be"
timeout = 5

[urgency_low]
timeout = 4

[urgency_critical]
frame_color = "#d9d7d4"
highlight = "#d9d7d4"
timeout = 0

[volume]
appname = volume
format = "<b>%s</b> %b"

[brightness]
appname = brightness
format = "<b>%s</b> %b"
