{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 0,
  "on-sigusr1": "toggle",
  "modules-left": ["ext/workspaces", "custom/title"],
  "modules-right": [
    "custom/dnd",
    "pulseaudio",
    "cpu",
    "temperature",
    "memory",
    "custom/gpu",
    "network",
    "clock",
    "tray",
  ],
  "ext/workspaces": {
    "format": "{name}",
    "sort-by-name": true,
    "ignore-hidden": false,
    "all-outputs": false,
    "on-click": "activate",
    "on-click-right": "deactivate",
  },
  "custom/title": {
    "exec": "bar-mango title",
    "return-type": "json",
    "escape": true,
    "max-length": 60,
    "tooltip": false,
  },
  "custom/dnd": {
    "exec": "if [ \"$(dunstctl is-paused)\" = true ]; then printf '󰂛 DND'; else printf '󰂚'; fi",
    "interval": 1,
    "tooltip": false,
    "on-click": "dunstctl set-paused toggle",
  },
  "pulseaudio": {
    "format": "󰕾 {volume}%",
    "format-muted": "󰝟 {volume}%",
    "scroll-step": 5,
    "max-volume": 100,
    "tooltip": false,
    "on-click": "foot wiremix",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
  },
  "cpu": {
    "format": " {usage}%",
    "interval": 5,
    "tooltip": false,
    "on-click": "foot btop",
  },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp3_input",
    "format": " {temperatureC}°C",
    "interval": 5,
    "tooltip": false,
  },
  "memory": {
    "format": " {used:.1f}GB",
    "interval": 5,
    "tooltip": false,
  },
  "custom/gpu": {
    "exec": "nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,noheader,nounits | awk -F ', ' '{printf \"󰢮 %s%% %s°C\\n\", $1, $2}'",
    "interval": 5,
    "tooltip": false,
    "on-click": "foot nvtop",
  },
  "network": {
    "format-wifi": "󰖩 {essid}",
    "format-ethernet": "󰈀 Wired",
    "format-disconnected": "󰖪 offline",
    "max-length": 18,
    "interval": 5,
    "escape": true,
    "tooltip": false,
    "on-click": "nm-connection-editor",
  },
  "clock": {
    "format": " {:%b %d %H:%M}",
    "interval": 1,
    "tooltip": true,
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#f1e6dc'><b>{}</b></span>",
        "weekdays": "<span color='#aaa19a'>{}</span>",
        "today": "<span color='#f1e6dc'><b><u>{}</u></b></span>",
      },
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
    },
  },
  "tray": {
    "icon-size": 16,
    "spacing": 2,
  },
}
