# Template file for 'xmonad'
pkgname=xmonad
version=0.18.1
revision=1
build_style=cabal
cabal_index_state=2026-09-30T23:00:00Z
_contrib_version=0.18.2
# Rebuild and bump revision whenever this compiler dependency changes.
_ghc_version=9.8.4
_ghc_revision=2
hostmakedepends="ghc pkg-config"
makedepends="libX11-devel libXext-devel libXinerama-devel libXrandr-devel
 libXScrnSaver-devel"
depends="ghc-${_ghc_version}_${_ghc_revision} ${makedepends}"
short_desc="Tiling window manager with its configuration libraries and extensions"
maintainer="Kieran Pedrick <kieran@aileks.dev>"
license="BSD-3-Clause"
homepage="https://xmonad.org"
distfiles="https://hackage.haskell.org/package/xmonad-${version}/xmonad-${version}.tar.gz
 https://hackage.haskell.org/package/xmonad-contrib-${_contrib_version}/xmonad-contrib-${_contrib_version}.tar.gz"
checksum="988b5f3104ac03aa078248afea7efcaed86661dfb239efd44995f58cd4f7a1f0
 2d83efa441110d35d02ddc286c04f7661d94c18e167a815ef7a2578b2a636a4d"
skip_extraction="xmonad-contrib-${_contrib_version}.tar.gz"
nocross=yes
make_check=no # The dotfiles workflow prohibits running tests.
nopie_files="/usr/bin/xmonad"
nostrip=yes
_cabal_args="--index-state=${cabal_index_state} --disable-tests --disable-benchmarks
 --disable-documentation --disable-shared --disable-library-profiling
 --disable-executable-profiling --disable-executable-dynamic"

post_extract() {
  vsrcextract -C contrib "xmonad-contrib-${_contrib_version}.tar.gz"
}

do_configure() {
  local compiler_package
  compiler_package=$(xbps-query -p pkgver ghc)
  if [ "$compiler_package" != "ghc-${_ghc_version}_${_ghc_revision}" ]; then
    msg_error "Update XMonad's GHC pin and bump revision before building with ${compiler_package}\n"
  fi

  cat >cabal.project <<-EOF
		packages: . ./contrib
		index-state: ${cabal_index_state}
		package xmonad-contrib
		  flags: -use_xft
	EOF
  cabal update
  cabal --store-dir="${wrksrc}/store" configure ${_cabal_args}
}

do_build() {
  # install --lib puts local libraries in the store, rather than dist-newstyle.
  cabal --store-dir="${wrksrc}/store" v2-install --lib lib:xmonad lib:xmonad-contrib \
    --package-env="${wrksrc}/environment" ${_cabal_args} ${makejobs}
  cabal --store-dir="${wrksrc}/store" build exe:xmonad ${_cabal_args} ${makejobs}
}

do_install() {
  local package_database=${DESTDIR}/usr/lib/xmonad/ghc-${_ghc_version}/package.db
  local registration

  vbin "$(cabal --store-dir="${wrksrc}/store" list-bin exe:xmonad)"
  vman man/xmonad.1
  vlicense LICENSE
  vlicense contrib/LICENSE xmonad-contrib-LICENSE
  vmkdir usr/lib/xmonad
  cp -a "${wrksrc}/store/ghc-${_ghc_version}" "${DESTDIR}/usr/lib/xmonad/"

  # Configs link Haskell libraries statically. Cabal's store also contains shared
  # copies that depend on GHC's private, unregistered shared libraries.
  find "${DESTDIR}/usr/lib/xmonad" \( -name '*.so' -o -name '*.dyn_hi' \) -delete

  # GHC registrations must refer to installed paths, not the build directory.
  for registration in "${package_database}"/*.conf; do
    sed -i "s|${wrksrc}/store/|/usr/lib/xmonad/|g" "$registration"
  done
  ghc-pkg --package-db="$package_database" recache
}
